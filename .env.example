NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel 서버 전용
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 수집 프로그램이 Vercel의 업종 분류 API를 호출할 때 쓰는 비밀값 (Vercel과 Mac에 같은 값)
